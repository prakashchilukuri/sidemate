# SideMate Environment Variables
# Copy this file to .env or .env.local for local development

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (PostgreSQL via Docker Compose or local instance)
DATABASE_URL="postgresql://sidemate_user:sidemate_password_dev@localhost:5432/sidemate_db?schema=public"

# Auth Session Secret (at least 32 characters for JOSE HS256 JWT signature)
AUTH_SECRET="sidemate_dev_jwt_secret_key_minimum_32_characters_long_for_hs256"

# Voice AI Service (FastAPI microservice in Phase 5)
VOICE_API_URL=http://localhost:8000
VOICE_API_KEY=sidemate_sandbox_voice_key

# Stripe (Billing & Usage in Phase 6)
STRIPE_SECRET_KEY=sk_test_mock
STRIPE_WEBHOOK_SECRET=whsec_mock
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_mock

# Redis (Celery & Caching)
REDIS_URL=redis://localhost:6379

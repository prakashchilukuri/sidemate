# Copy to services/voice/.env. Never commit real credentials.
# Generate a separate lab key: python -c "import secrets; print(secrets.token_urlsafe(32))"
VOICE_LAB_ACCESS_KEY=
SARVAM_API_KEY=
OPENROUTER_API_KEY=
VOICE_STT_MODEL=saaras:v4
VOICE_LLM_MODEL=nvidia/nemotron-3.5-super-vl:free
VOICE_TTS_MODEL=bulbul:v4-flash
VOICE_TELUGU_SPEAKER=kavitha_te_conversation
VOICE_ENGLISH_SPEAKER=simran_en_customer

# Optional Exotel callback pilot. Use a number you control for the first call.
EXOTEL_ACCOUNT_SID=
EXOTEL_OPERATOR_KEY=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_CALLER_ID=
EXOTEL_TEST_NUMBER=
EXOTEL_STREAM_ORIGIN=
# Optional path to a persistent SQLite file for the callback log.
EXOTEL_CALLBACK_DB=
